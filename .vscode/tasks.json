{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev:web",
      "type": "shell",
      "command": "pnpm --filter @redline/web dev",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "dev:api",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "dev:all",
      "dependsOn": ["dev:web", "dev:api"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "supabase:start",
      "type": "shell",
      "command": "supabase start",
      "group": "build"
    },
    {
      "label": "supabase:stop",
      "type": "shell",
      "command": "supabase stop",
      "group": "build"
    },
    {
      "label": "supabase:reset",
      "type": "shell",
      "command": "supabase db reset",
      "group": "build"
    },
    {
      "label": "db:generate-types",
      "type": "shell",
      "command": "supabase gen types typescript --local > apps/web/src/types/supabase.ts",
      "group": "build"
    }
  ]
}
